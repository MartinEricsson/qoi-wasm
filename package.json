{
  "name": "qoi-wasm",
  "version": "1.0.0",
  "description": "A QOI decoder written in WebAssembly",
  "main": "./dist/index.js",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./qoi.wasm": "./dist/qoi.wasm"
  },
  "scripts": {
    "compile": "node src/qoi-wasm/index.js",
    "kombine": "node src/kombine/index.js",
    "kombine:opt": "WASM_OPT=1 node src/kombine/index.js",
    "serve": "node serve.mjs",
    "build": "npm run compile && npx -y wasm-opt -Oz --enable-multivalue --strip-dwarf --strip-producers -o src/qoi-wasm/qoi.min.wasm src/qoi-wasm/qoi.wasm && node scripts/prepare-package.js",
    "prepublishOnly": "npm run build",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "npm run build && changeset publish"
  },
  "keywords": [
    "WASM",
    "QOI"
  ],
  "author": "Martin Ericsson",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MartinEricsson/qoi-wasm.git"
  },
  "homepage": "https://github.com/MartinEricsson/qoi-wasm#readme",
  "bugs": {
    "url": "https://github.com/MartinEricsson/qoi-wasm/issues"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "brotli": "1.3.2",
    "wabt": "1.0.25"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.8"
  }
}
